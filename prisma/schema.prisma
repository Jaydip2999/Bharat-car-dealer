generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  SALES_MANAGER
}

enum CarStatus {
  AVAILABLE
  RESERVED
  SOLD
  DRAFT
}

enum TestDriveStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum EnquiryStatus {
  NEW
  CONTACTED
  FOLLOW_UP
  CONVERTED
  RESOLVED
  CLOSED
}

enum SellRequestStatus {
  NEW
  CONTACTED
  INSPECTION_SCHEDULED
  VALUATION_DONE
  PURCHASED
  CLOSED
  PENDING
  EVALUATED
  OFFER_MADE
  ACCEPTED
  REJECTED
}

model AdminUser {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  passwordHash String
  role         Role      @default(ADMIN)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastLoginAt  DateTime?

  @@index([email])
}

model Car {
  id                String             @id @default(uuid())
  stockId           String             @unique // e.g. BW-2023-NX01
  brand             String
  model             String
  variant           String
  bodyType          String // SUV, Sedan, Hatchback, MUV, 4x4
  year              Int
  kilometers        Int
  fuelType          String // Petrol, Diesel, CNG, Electric, Hybrid
  transmission      String // Manual, Automatic, DCT/DCA, AMT, e-CVT
  price             Float // In Lakhs (e.g. 12.85)
  estimatedEmi      Int // In ₹ (e.g. 20490)
  city              String // Hub City
  rto               String // e.g. DL-8C
  ownership         String // 1st Owner, 2nd Owner
  insurance         String
  safetyRating      Int // 1 to 5 stars
  mileage           String // e.g. 17.2 km/l
  enginePower       String // e.g. 1.2L Turbocharged Revotron
  bootSpace         String // e.g. 382 Litres
  groundClearance   String // e.g. 208 mm
  inspectionScore   Int // 0 - 100
  certified         Boolean            @default(true)
  warranty          String             @default("1-Year Comprehensive Pan-India Warranty")
  color             String
  tag               String             @default("Certified Hub Selection")
  description       String             @default("")
  status            CarStatus          @default(AVAILABLE)
  featured          Boolean            @default(false)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  images            CarImage[]
  features          CarFeature[]
  testDriveBookings TestDriveBooking[]
  enquiries         Enquiry[]

  @@index([brand, model])
  @@index([status])
  @@index([price])
  @@index([city])
  @@index([bodyType])
  @@index([fuelType])
}

model CarImage {
  id        String   @id @default(uuid())
  carId     String
  car       Car      @relation(fields: [carId], references: [id], onDelete: Cascade)
  imageUrl  String
  altText   String   @default("")
  sortOrder Int      @default(0)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([carId])
  @@index([carId, sortOrder])
}

model CarFeature {
  id      String @id @default(uuid())
  carId   String
  car     Car    @relation(fields: [carId], references: [id], onDelete: Cascade)
  feature String

  @@index([carId])
}

model TestDriveBooking {
  id        String          @id @default(uuid())
  carId     String?
  car       Car?            @relation(fields: [carId], references: [id], onDelete: SetNull)
  fullName  String
  phone     String
  email     String?
  city      String
  address   String?
  mode      String          @default("doorstep") // doorstep or hub
  date      String
  timeSlot  String
  status    TestDriveStatus @default(PENDING)
  notes     String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([carId])
  @@index([status])
  @@index([createdAt])
}

model Enquiry {
  id        String        @id @default(uuid())
  carId     String?
  car       Car?          @relation(fields: [carId], references: [id], onDelete: SetNull)
  name      String
  phone     String
  email     String?
  message   String
  source    String        @default("website") // website, modal, whatsapp, financing
  status    EnquiryStatus @default(NEW)
  notes     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([carId])
  @@index([status])
  @@index([createdAt])
}

model SellCarRequest {
  id            String            @id @default(uuid())
  name          String
  phone         String
  email         String?
  carBrand      String
  carModel      String
  year          Int
  kilometers    Int
  expectedPrice Float? // in Lakhs
  city          String
  message       String?
  notes         String?
  status        SellRequestStatus @default(PENDING)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([status])
  @@index([createdAt])
}
